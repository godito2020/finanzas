FINANZA_DB_PATH=/absolute/private/path/finanza.sqlite
FINANZA_ALLOWED_ORIGINS=https://your-domain.example,https://localhost,capacitor://localhost
FINANZA_MASTER_SETUP_CODE=replace-with-a-long-one-time-installation-code
FINANZA_SETTINGS_ENCRYPTION_KEY=replace-with-a-random-secret-of-at-least-32-characters
FINANZA_SMTP_HOST=smtp.example.com
FINANZA_SMTP_PORT=587
FINANZA_SMTP_ENCRYPTION=tls
FINANZA_SMTP_USER=your-smtp-user
FINANZA_SMTP_PASSWORD=replace-with-a-secret
FINANZA_MAIL_FROM=noreply@your-domain.example
FINANZA_MAIL_FROM_NAME=Finanza
